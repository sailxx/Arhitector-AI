# Хостинг Reg.ru (Apache за nginx). На GitHub Pages этот файл не используется.
AddDefaultCharset utf-8
Options -Indexes

RewriteEngine On

# www → без www (после выпуска SSL поменять http на https)
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ http://arhitector-ai.ru%{REQUEST_URI} [R=301,L]

# http → https. Включить ТОЛЬКО после выпуска SSL-сертификата в панели хостинга,
# иначе сайт перестанет открываться.
# RewriteCond %{HTTPS} !=on
# RewriteCond %{HTTP:X-Forwarded-Proto} !=https
# RewriteRule ^ https://arhitector-ai.ru%{REQUEST_URI} [R=301,L]

# Служебные папки сборки не отдаём
RewriteRule ^(_src|_tools|\.github)(/|$) - [F,L]

# Кэш для картинок, иконок и скриптов
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
